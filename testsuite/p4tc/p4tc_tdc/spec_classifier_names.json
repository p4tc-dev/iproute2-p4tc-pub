[
    {
        "id": "bb7c",
        "name": "Classifier raw name 31 bytes with pipeid 0",
        "category": [
            "p4tc",
            "classifier",
            "name_capacity"
        ],
        "plugins": {
            "requires": "nsPlugin"
        },
        "setup": [
            "$TC p4template create pipeline/ppppppppppppppppppppppppppppppp pipeid 22 numtables 0",
            "$TC p4template update pipeline/ppppppppppppppppppppppppppppppp state ready",
            "ip link add dev p4d$TESTID type dummy",
            "$TC qdisc add dev p4d$TESTID clsact"
        ],
        "cmdUnderTest": "python3 \"$INTROSPECTION/classifier_name_boundary.py\" \"$TC\" p4d$TESTID 31 0",
        "expExitCode": "0",
        "verifyCmd": "$TC -j p4template get pipeline/ppppppppppppppppppppppppppppppp",
        "matchPattern": "\"pname\":\\s*\"ppppppppppppppppppppppppppppppp\"",
        "matchCount": "1",
        "teardown": [
            "ip link del dev p4d$TESTID",
            "sh -c 'for id in 22 23; do for attempt in $(seq 1 200); do out=$($TC p4template del pipeline/ pipeid \"$id\" 2>&1); rc=$?; case \"$out\" in *\"Pipeline in use\"*) sleep 0.05;; *) break;; esac; done; [ \"$rc\" -eq 0 ] || [ \"$rc\" -eq 255 ] || exit \"$rc\"; done'"
        ]
    },
