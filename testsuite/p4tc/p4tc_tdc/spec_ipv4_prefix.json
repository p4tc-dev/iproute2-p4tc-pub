[
    {
        "id": "e930",
        "name": "IPv4 /1 entry can be read using its network-order hexadecimal mask",
        "category": ["p4tc", "entries"],
        "setup": [
            ["$TC p4template del pipeline/ptables", 0, 1, 255],
            "$TC p4template create pipeline/ptables pipeid 22 numtables 1",
            "$TC p4template create table/ptables/cb/tname tblid 1 keysz 64 type lpm table_acts act name NoAction",
            "$TC p4template update pipeline/ptables state ready",
            "$TC p4ctrl create ptables/table/cb/tname srcAddr 192.0.2.1 dstAddr 128.0.0.0/1 prio 100"
        ],
        "cmdUnderTest": "$TC p4ctrl get ptables/table/cb/tname srcAddr 192.0.2.1 dstAddr 128.0.0.0/0x80000000",
        "expExitCode": "0",
        "verifyCmd": "$TC -j p4ctrl get ptables/table/cb/tname",
        "matchPattern": "\"fieldval\":\"128.0.0.0/1\"",
        "matchCount": "1",
        "teardown": [["$TC p4template del pipeline/ptables", 0]]
    },
