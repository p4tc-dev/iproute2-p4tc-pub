[
    {
        "id": "28b0",
        "name": "NS-01: Same pipeline name and id in two netns",
        "category": [
            "p4tc",
            "template",
            "spec_netns"
        ],
        "setup": [
            [
                "ip netns del p4nsA$TESTID",
                0,
                1,
                2,
                255
            ],
            [
                "ip netns del p4nsB$TESTID",
                0,
                1,
                2,
                255
            ],
            "ip netns add p4nsA$TESTID",
            "ip netns add p4nsB$TESTID",
            "ip netns exec p4nsA$TESTID $TC p4template create pipeline/ptables pipeid 22 numtables 1"
        ],
        "cmdUnderTest": "ip netns exec p4nsB$TESTID $TC p4template create pipeline/ptables pipeid 22 numtables 1",
        "expExitCode": "0",
        "verifyCmd": "{ ip netns exec p4nsA$TESTID $TC -j p4template get pipeline/ptables; ip netns exec p4nsB$TESTID $TC -j p4template get pipeline/ptables; } 2>&1; true",
        "matchCount": "1",
        "matchPattern": "(?s)\"pname\":\\s*\"ptables\".*\"pname\":\\s*\"ptables\"",
        "teardown": [
            [
                "ip netns del p4nsA$TESTID",
                0,
                1,
                2,
                255
            ],
            [
                "ip netns del p4nsB$TESTID",
                0,
                1,
                2,
                255
            ],
            [
                "sh -c 'for attempt in $(seq 1 200); do output=$($TC p4template del pipeline/ptables 2>&1); rc=$?; [ \"$rc\" -eq 0 ] && break; case \"$output\" in *\"Pipeline in use\"*) sleep 0.05;; *) break;; esac; done; [ -z \"$output\" ] || printf '\"'\"'%s\\n'\"'\"' \"$output\" >&2; exit \"$rc\"'",
                0,
                1,
                2,
                255
            ],
            [
                "$TC actions flush action gact",
                0,
                1,
                2,
                255
            ],
            [
                "$TC p4template del extern/root/myext",
                0,
                1,
                2,
                255
            ],
            [
                "$TC p4template del extern/root/E1",
                0,
                1,
                2,
                255
            ],
            [
                "$TC p4template del extern/root/E2",
                0,
                1,
                2,
                255
            ],
            [
                "$TC p4template del extern/root/Counter",
                0,
                1,
                2,
                255
            ],
            [
                "$TC p4template del extern/root/DirectCounter",
                0,
                1,
                2,
                255
            ],
            [
                "$TC p4template del extern/root/Meter",
                0,
                1,
                2,
                255
            ],
            [
                "$TC p4template del extern/root/DirectMeter",
                0,
                1,
                2,
                255
            ],
            [
                "$TC p4template del extern/root/Digest",
                0,
                1,
                2,
                255
            ],
            [
                "$TC p4template del extern/root/NoSuchExt",
                0,
                1,
                2,
                255
            ]
        ]
